# Don't commit actual configuration or environment files.
.env*

# Ignore compiled templates except for .gitkeep files.
/cli/templates_compiled/*
!/cli/templates_compiled/.gitkeep
/app/templates_compiled/*
!/app/templates_compiled/.gitkeep

# Ignore logs.
/app/logs/*

# Ignore host MariaDB data files while keeping the directory in git.
/docker/mariadb/data/*
!/docker/mariadb/data/.gitkeep

# Ignore vendor files.
vendor/

node_modules

# No turd files, including OS generated files.
*.swp
*.bak
*.tmp
.DS_Store
Thumbs.db
