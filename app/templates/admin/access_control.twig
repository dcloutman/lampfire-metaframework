{% extends "admin/layout.twig" %}

{% block admin_content %}
{% set current_section = active_section | default('permissions') %}
{% set section_title_map = {
    'permissions': 'Permissions',
    'user-groups': 'User Groups',
    'permission-sets': 'Permission Sets',
    'set-permissions': 'Permission Assignments',
    'set-members': 'User Assignments',
    'set-group-assignments': 'Group Assignments'
} %}
{% set section_title = section_title_map[current_section] | default('Access Control') %}
<header class="page-header">
    <h1>{{ section_title }}</h1>
</header>

<div
    data-access-control-root
    data-csrf-token="{{ csrf_token }}"
    data-active-section="{{ current_section }}"
    data-admin-group-name="{{ admin_group_name | default('') | e('html_attr') }}"
    data-admin-permission-token-prefix="{{ admin_permission_token_prefix | default('') | e('html_attr') }}"
>
    <div id="access-control-message" class="alert" style="display: none;"></div>

    <section class="detail-section"{% if current_section != 'permissions' %} style="display: none;"{% endif %}>
        <h2>Permissions</h2>
        <form id="permission-form" class="admin-form" method="post" action="/api/permissions">
            <input type="hidden" id="permission_id" name="permission_id" />
            <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
            <div>
                <label for="permission_token">Permission Token</label>
                <input type="text" id="permission_token" name="permission_token" required minlength="2" />
            </div>
            <div>
                <label for="permission_title">Permission Title</label>
                <input type="text" id="permission_title" name="permission_title" required minlength="2" />
            </div>
            <div>
                <label for="permission_notes">Notes</label>
                <input type="text" id="permission_notes" name="notes" />
            </div>
            <footer>
                <button type="submit" id="permission-submit">Create Permission</button>
                <button type="button" id="permission-cancel" style="display: none;">Cancel Edit</button>
            </footer>
        </form>

        <div class="table-wrap">
            <table class="data" id="permissions-table">
                <thead>
                    <tr>
                        <th>Token</th>
                        <th>Title</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% if permissions is defined and permissions|length > 0 %}
                        {% for permission in permissions %}
                        {% set is_immutable_permission = admin_permission_token_prefix is not empty and permission.permission_token starts with admin_permission_token_prefix %}
                        <tr>
                            <td>{{ permission.permission_token }}</td>
                            <td>{{ permission.permission_title }}</td>
                            <td>{{ permission.notes | default('') }}</td>
                            <td class="actions">
                                {% if is_immutable_permission %}
                                <span title="Framework administrative permissions are immutable.">Immutable</span>
                                {% else %}
                                <form method="post" action="/api/permissions/{{ permission.permission_id }}" class="membership-update-form" style="display: inline-block; margin-right: 0.5rem;">
                                    <input type="hidden" name="_METHOD" value="PUT" />
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
                                    <input type="text" name="permission_token" value="{{ permission.permission_token }}" required minlength="2" />
                                    <input type="text" name="permission_title" value="{{ permission.permission_title }}" required minlength="2" />
                                    <input type="text" name="notes" value="{{ permission.notes | default('') }}" />
                                    <button type="submit">Save</button>
                                </form>
                                <form method="post" action="/api/permissions/{{ permission.permission_id }}" style="display: inline-block;" data-confirm="Delete this permission?">
                                    <input type="hidden" name="_METHOD" value="DELETE" />
                                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
                                    <button type="submit">Delete</button>
                                </form>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="4">No permissions found.</td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </section>

    <section class="detail-section"{% if current_section != 'user-groups' %} style="display: none;"{% endif %}>
        <h2>User Groups</h2>
        <form id="user-group-form" class="admin-form">
            <input type="hidden" id="user_group_id" name="user_group_id" />
            <div>
                <label for="group_name">Group Name</label>
                <input type="text" id="group_name" name="group_name" required minlength="2" />
            </div>
            <div>
                <label for="group_description">Description</label>
                <input type="text" id="group_description" name="description" />
            </div>
            <footer>
                <button type="submit" id="user-group-submit">Create Group</button>
                <button type="button" id="user-group-cancel" style="display: none;">Cancel Edit</button>
            </footer>
        </form>

        <div class="table-wrap">
            <table class="data" id="user-groups-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </section>

    <section class="detail-section"{% if current_section != 'permission-sets' %} style="display: none;"{% endif %}>
        <h2>Permission Sets</h2>
        <form id="permission-set-form" class="admin-form">
            <input type="hidden" id="permission_set_id" name="permission_set_id" />
            <div>
                <label for="permission_set_token">Permission Set Token</label>
                <input type="text" id="permission_set_token" name="permission_set_token" required minlength="2" />
            </div>
            <div>
                <label for="permission_set_title">Title</label>
                <input type="text" id="permission_set_title" name="title" required minlength="2" />
            </div>
            <div>
                <label for="permission_set_notes">Notes</label>
                <input type="text" id="permission_set_notes" name="notes" />
            </div>
            <footer>
                <button type="submit" id="permission-set-submit">Create Permission Set</button>
                <button type="button" id="permission-set-cancel" style="display: none;">Cancel Edit</button>
            </footer>
        </form>

        <div class="table-wrap">
            <table class="data" id="permission-sets-table">
                <thead>
                    <tr>
                        <th>Token</th>
                        <th>Title</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </section>

    <section class="detail-section"{% if current_section != 'set-permissions' %} style="display: none;"{% endif %}>
        <h2>Permission Set Permissions</h2>
        <form id="set-permission-form" class="admin-form">
            <input type="hidden" id="set_permission_permission_set_id_original" name="set_permission_permission_set_id_original" />
            <input type="hidden" id="set_permission_permission_id_original" name="set_permission_permission_id_original" />
            <div>
                <label for="set_permission_permission_set_id">Permission Set</label>
                <select id="set_permission_permission_set_id" name="permission_set_id" required></select>
            </div>
            <div>
                <label for="set_permission_permission_id">Permission</label>
                <select id="set_permission_permission_id" name="permission_id" required></select>
            </div>
            <div>
                <label for="set_permission_notes">Notes</label>
                <input type="text" id="set_permission_notes" name="notes" />
            </div>
            <footer>
                <button type="submit" id="set-permission-submit">Add Permission To Set</button>
                <button type="button" id="set-permission-cancel" style="display: none;">Cancel Edit</button>
            </footer>
        </form>

        <div class="table-wrap">
            <table class="data" id="set-permissions-table">
                <thead>
                    <tr>
                        <th>Permission Set</th>
                        <th>Permission</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </section>

    <section class="detail-section"{% if current_section != 'set-members' %} style="display: none;"{% endif %}>
        <h2>Permission Set Members</h2>
        <form id="set-member-form" class="admin-form">
            <input type="hidden" id="set_member_permission_set_id_original" name="set_member_permission_set_id_original" />
            <input type="hidden" id="set_member_user_id_original" name="set_member_user_id_original" />
            <div>
                <label for="set_member_permission_set_id">Permission Set</label>
                <select id="set_member_permission_set_id" name="permission_set_id" required></select>
            </div>
            <div>
                <label for="set_member_user_id">User</label>
                <select id="set_member_user_id" name="user_id" required></select>
            </div>
            <div>
                <label for="set_member_access_granted">Access Granted (UTC)</label>
                <input type="text" id="set_member_access_granted" name="access_granted" required />
            </div>
            <div>
                <label for="set_member_access_expiry">Access Expiry (UTC)</label>
                <input type="text" id="set_member_access_expiry" name="access_expiry" required />
            </div>
            <div>
                <label for="set_member_has_access">Access Status</label>
                <select id="set_member_has_access" name="has_access" required>
                    <option value="1">Active</option>
                    <option value="0">Disabled</option>
                </select>
            </div>
            <div>
                <label for="set_member_notes">Notes</label>
                <input type="text" id="set_member_notes" name="notes" />
            </div>
            <footer>
                <button type="submit" id="set-member-submit">Add User To Permission Set</button>
                <button type="button" id="set-member-cancel" style="display: none;">Cancel Edit</button>
            </footer>
        </form>

        <p class="membership-note">Date format must be YYYY-MM-DD HH:MM:SS in UTC.</p>

        <div class="table-wrap">
            <table class="data" id="set-members-table">
                <thead>
                    <tr>
                        <th>Permission Set</th>
                        <th>User</th>
                        <th>Granted</th>
                        <th>Expiry</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </section>

    <section class="detail-section"{% if current_section != 'set-group-assignments' %} style="display: none;"{% endif %}>
        <h2>User Group Permission Set Assignments</h2>
        <p class="membership-note">User groups receive permissions through permission sets. Assign a group to a permission set here.</p>
        <form id="assignment-form" class="admin-form">
            <input type="hidden" id="assignment_user_group_id_original" name="assignment_user_group_id_original" />
            <input type="hidden" id="assignment_permission_set_id_original" name="assignment_permission_set_id_original" />
            <div>
                <label for="assignment_user_group_id">User Group</label>
                <select id="assignment_user_group_id" name="user_group_id" required></select>
            </div>
            <div>
                <label for="assignment_permission_set_id">Permission Set</label>
                <select id="assignment_permission_set_id" name="permission_set_id" required></select>
            </div>
            <div>
                <label for="assignment_access_granted">Access Granted (UTC)</label>
                <input type="text" id="assignment_access_granted" name="access_granted" required />
            </div>
            <div>
                <label for="assignment_access_expiry">Access Expiry (UTC)</label>
                <input type="text" id="assignment_access_expiry" name="access_expiry" required />
            </div>
            <div>
                <label for="assignment_has_access">Access Status</label>
                <select id="assignment_has_access" name="has_access" required>
                    <option value="1">Active</option>
                    <option value="0">Disabled</option>
                </select>
            </div>
            <div>
                <label for="assignment_notes">Notes</label>
                <input type="text" id="assignment_notes" name="notes" />
            </div>
            <footer>
                <button type="submit" id="assignment-submit">Create Assignment</button>
                <button type="button" id="assignment-cancel" style="display: none;">Cancel Edit</button>
            </footer>
        </form>

        <p class="membership-note">Date format must be YYYY-MM-DD HH:MM:SS in UTC.</p>

        <div class="table-wrap">
            <table class="data" id="assignments-table">
                <thead>
                    <tr>
                        <th>User Group</th>
                        <th>Permission Set</th>
                        <th>Granted</th>
                        <th>Expiry</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </section>
</div>
{% endblock %}
