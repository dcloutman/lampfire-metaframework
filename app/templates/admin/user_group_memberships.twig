{% extends "admin/layout.twig" %}

{% block admin_content %}
<header class="page-header">
    <h1>User Group Memberships</h1>
</header>

<div data-user-group-memberships-root data-csrf-token="{{ csrf_token }}">
    <div id="user-group-memberships-message" class="alert" style="display: none;"></div>

    <section class="detail-section">
        <h2>User to Group Membership</h2>

        <form id="user-group-membership-form" class="admin-form">
            <input type="hidden" id="membership_user_id_original" name="membership_user_id_original" />
            <input type="hidden" id="membership_user_group_id_original" name="membership_user_group_id_original" />
            <div>
                <label for="membership_user_id">User</label>
                <select id="membership_user_id" name="user_id" required></select>
            </div>
            <div>
                <label for="membership_user_group_id">User Group</label>
                <select id="membership_user_group_id" name="user_group_id" required></select>
            </div>
            <div>
                <label for="membership_access_granted">Access Granted (UTC)</label>
                <input type="text" id="membership_access_granted" name="access_granted" required />
            </div>
            <div>
                <label for="membership_access_expiry">Access Expiry (UTC)</label>
                <input type="text" id="membership_access_expiry" name="access_expiry" required />
            </div>
            <div>
                <label for="membership_has_access">Access Status</label>
                <select id="membership_has_access" name="has_access" required>
                    <option value="1">Active</option>
                    <option value="0">Disabled</option>
                </select>
            </div>
            <footer>
                <button type="submit" id="membership-submit">Create Membership</button>
                <button type="button" id="membership-cancel" style="display: none;">Cancel Edit</button>
            </footer>
        </form>

        <p class="membership-note">Date format must be YYYY-MM-DD HH:MM:SS in UTC.</p>

        <div class="table-wrap">
            <table class="data" id="user-group-memberships-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>User Group</th>
                        <th>Granted</th>
                        <th>Expiry</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </section>
</div>
{% endblock %}

{% block scripts %}
    <script src="/js/user_group_memberships.js"></script>
{% endblock %}
