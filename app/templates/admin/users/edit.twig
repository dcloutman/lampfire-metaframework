{# Form to edit an existing user record. #}
{% extends "admin/layout.twig" %}

{% block admin_content %}
<header class="page-header">
    <h1>Edit User</h1>
</header>

<form method="post" action="/admin/users/{{ user.user_id }}" class="admin-form">
    <input type="hidden" name="_METHOD" value="PUT" />
    <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />

    <div class="form-group">
        <label for="username" class="form-label">Username</label>
        <input
            type="text"
            id="username"
            name="username"
            class="form-input"
            required
            minlength="3"
            value="{{ user.username }}"
        />
    </div>

    <div class="form-group">
        <label for="first_name" class="form-label">First Name</label>
        <input
            type="text"
            id="first_name"
            name="first_name"
            class="form-input"
            value="{{ user.first_name | default('') }}"
        />
    </div>

    <div class="form-group">
        <label for="last_name" class="form-label">Last Name</label>
        <input
            type="text"
            id="last_name"
            name="last_name"
            class="form-input"
            value="{{ user.last_name | default('') }}"
        />
    </div>

    <div class="form-group">
        <label for="email_address" class="form-label">Email Address</label>
        <input
            type="email"
            id="email_address"
            name="email_address"
            class="form-input"
            required
            value="{{ user.email_address | default('') }}"
        />
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a href="/admin/users/{{ user.user_id }}" class="btn btn-secondary">Cancel</a>
    </div>
</form>
{% endblock %}
