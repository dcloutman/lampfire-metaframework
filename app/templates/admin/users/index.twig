{# Lists all user records in a data table. #}
{% extends "admin/layout.twig" %}

{% block admin_content %}
<header class="page-header">
    <h1>Users</h1>
    <a href="/admin/users?action=create" class="btn btn-primary">Create New User</a>
</header>

{% if users | length > 0 %}
<table class="data-table">
    <thead>
        <tr>
            <th>Username</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for user in users %}
        <tr>
            <td>{{ user.username }}</td>
            <td>{{ user.first_name | default('--') }}</td>
            <td>{{ user.last_name | default('--') }}</td>
            <td>{{ user.email_address | default('--') }}</td>
            <td>{{ user.created_at }}</td>
            <td class="table-actions">
                <a href="/admin/users/{{ user.user_id }}" class="btn btn-small">View</a>
                <a href="/admin/users/{{ user.user_id }}?action=edit" class="btn btn-small">Edit</a>
                <form method="post" action="/admin/users/{{ user.user_id }}" class="inline-form" data-confirm="Are you sure you want to delete this user?">
                    <input type="hidden" name="_METHOD" value="DELETE" />
                    <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />
                    <button type="submit" class="btn btn-small btn-danger">Delete</button>
                </form>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<p class="empty-state">No users have been created yet.</p>
{% endif %}
{% endblock %}
