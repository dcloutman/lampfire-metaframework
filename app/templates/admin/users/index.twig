{# Lists all user records in a data table. #}
{% extends "admin/layout.twig" %}

{% block admin_content %}
<header class="page-header">
    <h1>Users</h1>
    <a href="/admin/users?action=create">Create New User</a>
</header>

{% if users | length > 0 %}
<table class="data">
    <thead>
        <tr>
            <th>Username</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Created</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        {% for user in users %}
        <tr>
            <td>{{ user.username }}</td>
            <td>{{ user.first_name | default('--') }}</td>
            <td>{{ user.last_name | default('--') }}</td>
            <td>{{ user.email_address | default('--') }}</td>
            <td>{{ user.created_at }}</td>
            <td>{{ user.enabled ? 'Enabled' : 'Disabled' }}</td>
            <td class="actions">
                <a href="/admin/users/{{ user.user_id }}">Edit</a>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% else %}
<p class="empty-state">No users have been created yet.</p>
{% endif %}
{% endblock %}
