{# Detailed view of a single user with password reset form. #}
{% extends "admin/layout.twig" %}

{% block admin_content %}
<header class="page-header">
    <h1>User Details</h1>
    <div class="page-header-actions">
        <a href="/admin/users/{{ user.user_id }}?action=edit" class="btn btn-primary">Edit</a>
    </div>
</header>

<section class="detail-section">
    <dl class="detail-list">
        <dt>User ID</dt>
        <dd>{{ user.user_id }}</dd>

        <dt>Username</dt>
        <dd>{{ user.username }}</dd>

        <dt>First Name</dt>
        <dd>{{ user.first_name | default('--') }}</dd>

        <dt>Last Name</dt>
        <dd>{{ user.last_name | default('--') }}</dd>

        <dt>Email Address</dt>
        <dd>{{ user.email_address | default('--') }}</dd>

        <dt>Account Status</dt>
        <dd>{{ user.enabled ? 'Enabled' : 'Disabled' }}</dd>

        <dt>Created</dt>
        <dd>{{ user.created_at }}</dd>

        <dt>Updated</dt>
        <dd>{{ user.updated_at }}</dd>
    </dl>
</section>

<section class="detail-section">
    <h2>Reset Password</h2>

    {% if password_error is defined and password_error is not null %}
    <div class="alert alert-error">
        {{ password_error }}
    </div>
    {% endif %}

    <form method="post" action="/admin/users/{{ user.user_id }}" class="admin-form">
        <input type="hidden" name="_METHOD" value="PUT" />
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}" />

        <div class="form-group">
            <label for="new_password" class="form-label">New Password</label>
            <input
                type="password"
                id="new_password"
                name="new_password"
                class="form-input"
                required
                minlength="8"
                autocomplete="new-password"
            />
        </div>

        <div class="form-group">
            <label for="new_password_confirm" class="form-label">Confirm New Password</label>
            <input
                type="password"
                id="new_password_confirm"
                name="new_password_confirm"
                class="form-input"
                required
                minlength="8"
                autocomplete="new-password"
            />
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Reset Password</button>
        </div>
    </form>
</section>

<div class="back-link">
    <a href="/admin/users">Back to user list</a>
</div>
{% endblock %}
