{# Public homepage with a login form. #}
{% extends "_base.twig" %}

{% block title %}{{ projectName }}{% endblock %}

{% block content %}
<div class="homepage">
    <header class="homepage-header">
        <div class="homepage-brand">{{ projectName }}</div>
    </header>

    <main class="homepage-main">
        <div class="homepage-hero">
            <h1 class="homepage-heading">Welcome</h1>
            <p class="homepage-subheading">Sign in to your account.</p>
        </div>

        <div class="login-card">
            {% if error is defined and error is not null %}
            <div class="alert alert-error">
                {{ error }}
            </div>
            {% endif %}

            <form method="post" action="/" class="login-form">
                <div>
                    <label for="username">Username</label>
                    <input
                        type="text"
                        id="username"
                        name="username"
                        required
                        autocomplete="username"
                        autofocus
                    />
                </div>
                <div>
                    <label for="password">Password</label>
                    <input
                        type="password"
                        id="password"
                        name="password"
                        required
                        autocomplete="current-password"
                    />
                </div>
                <footer>
                    <button type="submit">Sign In</button>
                </footer>
            </form>
        </div>
    </main>

    <footer class="homepage-footer">
        <p>&copy; {{ "now" | date("Y") }} {{ organizationName }}</p>
    </footer>
</div>
{% endblock %}
