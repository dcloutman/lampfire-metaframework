{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "strict": true,
        "outDir": "src/public/js",
        "rootDir": "src/ts",
        "sourceMap": false,
        "declaration": false,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true
    },
    "include": ["src/ts/**/*.ts"]
}
